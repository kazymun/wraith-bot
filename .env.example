# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Solana RPC endpoint. The public mainnet endpoint is heavily rate-limited
# and not reliable for a production bot. Use a dedicated provider
# (Helius, QuickNode, Triton, etc.) for anything beyond local testing.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# 32-byte master key, base64-encoded, used to encrypt every user's
# private key at rest with AES-256-GCM. Generate one with:
#   openssl rand -base64 32
# Treat this like a root password. If it leaks, every custodied wallet
# is compromised. If you lose it, every custodied wallet is unrecoverable.
WRAITH_MASTER_KEY=

# Path where the local sled database is stored
DB_PATH=./wraith_db

# Default slippage in basis points (500 = 5%)
DEFAULT_SLIPPAGE_BPS=500
